# Fan Zone Profit Engine — environment configuration
# Copy to `.env` and fill in. Never commit the real .env.

# MongoDB Atlas connection string (cluster: worldcup-data, db: fanzone)
MONGODB_URI=mongodb+srv://<user>:<pass>@worldcup-data.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Google Cloud / Vertex AI
GCP_PROJECT=fan-zone-agent-2026
GCP_REGION=us-central1

# Gemini model used by the Vertex AI reasoning step
GEMINI_MODEL=gemini-1.5-pro

# Command that launches MongoDB's MCP server (the partner integration).
# In the Docker image it's installed globally and on PATH (default below).
# For local dev, point this at your install, e.g. the npm-global bin path, or
# use: npx -y mongodb-mcp-server
MONGODB_MCP_CMD=mongodb-mcp-server

# Server port (Cloud Run injects PORT=8080)
PORT=8080
